# Copy to .env and fill in. Never commit the real .env.

# Required: docker compose refuses to start without these. Use long random strings
# (e.g. `openssl rand -hex 32`); they must be different from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Browser origin of the client, as the user's browser sends it (no trailing slash).
CORS_ORIGIN=http://localhost

# API URL baked into the client bundle at build time; must be reachable from the browser.
VITE_API_URL=http://localhost:5000/api/v1

# AI service (Ollama runs on the host by default).
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:mini
AI_CORS_ORIGINS=http://localhost:5000
