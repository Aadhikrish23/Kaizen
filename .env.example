# Copy to .env and fill in. Never commit the real .env.

# Required: docker compose refuses to start without these. Use long random strings
# (e.g. `openssl rand -hex 32`); they must be different from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Browser origin of the client, as the user's browser sends it (no trailing slash).
CORS_ORIGIN=http://localhost

# API URL baked into the client bundle at build time; must be reachable from the browser.
VITE_API_URL=http://localhost:5000/api/v1

# AI service. AI_PROVIDER selects the primary LLM backend: nvidia (default) | ollama | openai | anthropic.
# AI_FALLBACK_PROVIDERS (comma separated, default ollama) are tried in order when the primary gives no answer.
# API keys come from the environment only; never commit them. With no provider reachable the app falls back to
# deterministic heuristics (coach replies, food parsing).
AI_PROVIDER=nvidia
AI_FALLBACK_PROVIDERS=ollama
# nvidia: NVIDIA NIM hosted models (key from https://build.nvidia.com). Models are tried in order on the same key.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FALLBACK_MODELS=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# openai: OpenAI or any OpenAI-compatible gateway (set OPENAI_BASE_URL for the gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# anthropic: Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# ollama (runs on the host by default)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:mini
AI_CORS_ORIGINS=http://localhost:5000
# Shared secret (16+ characters, same value for the server and the AI service) so the AI service's calls back into the API skip the
# per-IP rate limit (users stay limited per account). Without it, behind one proxy address every AI call shares the 100 requests per
# 15 minutes budget. Generate with: openssl rand -hex 24
AI_INTERNAL_TOKEN=
# Where the AI service reaches the API when not using compose (compose sets http://server:5000/api/v1)
# KAIZEN_API_URL=http://localhost:5000/api/v1
