# Copy to .env and fill in. Never commit the real .env.

# Required: docker compose refuses to start without these. Use long random strings
# (e.g. `openssl rand -hex 32`); they must be different from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Browser origin of the client, as the user's browser sends it (no trailing slash).
CORS_ORIGIN=http://localhost

# API URL baked into the client bundle at build time; must be reachable from the browser.
VITE_API_URL=http://localhost:5000/api/v1

# AI service. AI_PROVIDER selects the LLM backend: ollama (default) | openai | anthropic.
# API keys come from the environment only; never commit them. With no provider reachable the app falls back to
# deterministic heuristics (coach replies, food parsing).
AI_PROVIDER=ollama
# openai: OpenAI or any OpenAI-compatible gateway (set OPENAI_BASE_URL for the gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# anthropic: Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# ollama (runs on the host by default)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:mini
AI_CORS_ORIGINS=http://localhost:5000
